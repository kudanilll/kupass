<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Only the system (holding BIND_AUTOFILL_SERVICE) can bind. -->
        <service
            android:name="com.nielcode.kupass.autofill.KupassAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
        >
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>

        <!-- Started only through Kupass's own PendingIntents. -->
        <activity
            android:name="com.nielcode.kupass.autofill.AutofillGenerateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kupass.Autofill"
        />
        <activity
            android:name="com.nielcode.kupass.autofill.AutofillUnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kupass.Autofill"
        />
    </application>
</manifest>
