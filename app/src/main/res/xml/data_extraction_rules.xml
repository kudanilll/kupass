<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup and transfer rules.

    Kupass never lets the OS copy vault data: the database (and its Keystore-bound ciphertext) and
    preferences stay on this device. Users move their vault with the app's own password-protected
    backup (Data → Export) instead.

    allowBackup="false" already disables cloud backup, but some manufacturers still run
    device-to-device migration, so every domain is excluded explicitly here as well.
    Cross-platform (iOS) transfer is opt-in via <platform-specific-params> and is not configured.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
