<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and lower (API <= 30). Ignored on API 31+, which uses
    data_extraction_rules.xml. Nothing in the app sandbox is backed up; see that file for why.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
